# Copiá este archivo como .env.local (y cargá las mismas variables en Vercel → Settings → Environment Variables).
# Se obtienen en Firebase Console → Configuración del proyecto → Tus apps → App web.
# Si quedan vacías, la app funciona en modo demo (datos guardados solo en el navegador).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Región de las Cloud Functions (Mercado Pago). São Paulo es la más cercana.
VITE_FIREBASE_FUNCTIONS_REGION=southamerica-east1
